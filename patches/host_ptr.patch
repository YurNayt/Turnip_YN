+/* Local copies of the legacy KGSL uapi (same layout as msm_kgsl.h). */
+struct tu_kgsl_map_user_mem {
+   int fd;
+   unsigned long gpuaddr;
+   size_t len;
+   size_t offset;
+   unsigned long hostptr;
+   int memtype;
+   unsigned int flags;
+};
+struct tu_kgsl_gpumem_get_info {
+   unsigned long gpuaddr;
+   unsigned int id;
+   unsigned int flags;
+   size_t size;
+   size_t mmapsize;
+   unsigned long useraddr;
+   unsigned long __pad[4];
+};
+struct tu_kgsl_sharedmem_free {
+   unsigned long gpuaddr;
+};
+#define TU_IOCTL_KGSL_MAP_USER_MEM \
+   _IOWR(0x09, 0x15, struct tu_kgsl_map_user_mem)
+#define TU_IOCTL_KGSL_SHAREDMEM_FREE \
+   _IOW(0x09, 0x21, struct tu_kgsl_sharedmem_free)
+#define TU_IOCTL_KGSL_GPUMEM_GET_INFO \
+   _IOWR(0x09, 0x36, struct tu_kgsl_gpumem_get_info)
+
+static VkResult
+kgsl_bo_init_host_ptr(struct tu_device *dev,
+                      struct tu_bo **out_bo,
+                      void *host_ptr,
+                      uint64_t size,
+                      enum tu_bo_alloc_flags flags)
+{
+   int fd = dev->physical_device->local_fd;
+
+   /* App memory is mapped write-back cached on the CPU: let the GPU snoop
+    * the CPU caches, otherwise GPU writes are invisible to the CPU. */
+   uint64_t host_ptr_flags = KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT;
+   if (dev->physical_device->has_cached_coherent_memory)
+      host_ptr_flags |= KGSL_MEMFLAGS_IOCOHERENT;
+
+   struct tu_kgsl_map_user_mem map_req;
+   memset(&map_req, 0, sizeof(map_req));
+   map_req.fd = -1;
+   map_req.len = size;
+   map_req.offset = 0;
+   map_req.hostptr = (unsigned long)(uintptr_t)host_ptr;
+   map_req.memtype = KGSL_USER_MEM_TYPE_ADDR;
+   map_req.flags = (unsigned int)host_ptr_flags;
+
+   int ret = safe_ioctl(fd, TU_IOCTL_KGSL_MAP_USER_MEM, &map_req);
+   if (ret) {
+      int e = errno;
+      fprintf(stderr, "TUDBG hostptr MAP_USER_MEM failed va=%p size=0x%llx flags=0x%x errno=%d (%s)\n",
+              host_ptr, (unsigned long long)size, map_req.flags, e, strerror(e));
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to map host pointer %p (%s)\n",
+                       host_ptr, strerror(e));
+   }
+
+   struct tu_kgsl_gpumem_get_info info_req;
+   memset(&info_req, 0, sizeof(info_req));
+   info_req.gpuaddr = map_req.gpuaddr;
+   ret = safe_ioctl(fd, TU_IOCTL_KGSL_GPUMEM_GET_INFO, &info_req);
+   if (ret || !info_req.id || info_req.size < size) {
+      int e = errno;
+      fprintf(stderr, "TUDBG hostptr GET_INFO failed ret=%d errno=%d id=%u size=0x%llx\n",
+              ret, e, info_req.id, (unsigned long long)info_req.size);
+      struct tu_kgsl_sharedmem_free free_req = { .gpuaddr = map_req.gpuaddr };
+      safe_ioctl(fd, TU_IOCTL_KGSL_SHAREDMEM_FREE, &free_req);
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to get host ptr info\n");
+   }
+
+   fprintf(stderr, "TUDBG hostptr OK va=%p size=0x%llx gpu=0x%lx id=%u req_flags=0x%x got_flags=0x%x ksize=0x%llx\n",
+           host_ptr, (unsigned long long)size, map_req.gpuaddr, info_req.id,
+           map_req.flags, info_req.flags, (unsigned long long)info_req.size);
+
+   struct tu_bo *bo = tu_device_lookup_bo(dev, info_req.id);
