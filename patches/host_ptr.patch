diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 5580ed8..266b528 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -448,6 +448,79 @@ kgsl_bo_init_dmabuf(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+static VkResult
+kgsl_bo_init_host_ptr(struct tu_device *dev,
+                      struct tu_bo **out_bo,
+                      void *host_ptr,
+                      uint64_t size,
+                      enum tu_bo_alloc_flags flags)
+{
+   struct kgsl_gpuobj_import_useraddr import_useraddr = {
+      .virtaddr = (uint64_t)(uintptr_t)host_ptr,
+   };
+   struct kgsl_gpuobj_import req = {
+      .priv = reinterpret_cast<uintptr_t>(&import_useraddr),
+      .priv_len = sizeof(import_useraddr),
+      .flags = 0,
+      .type = KGSL_USER_MEM_TYPE_ADDR,
+   };
+
+   int ret = safe_ioctl(dev->physical_device->local_fd,
+                        IOCTL_KGSL_GPUOBJ_IMPORT, &req);
+   if (ret)
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to import host pointer %p (%s)\n",
+                       host_ptr, strerror(errno));
+
+   auto free_obj = [&]() {
+      struct kgsl_gpumem_free_id free_req = { .id = req.id };
+      safe_ioctl(dev->physical_device->local_fd,
+                 IOCTL_KGSL_GPUMEM_FREE_ID, &free_req);
+   };
+
+   struct kgsl_gpuobj_info info_req = {
+      .id = req.id,
+   };
+   ret = safe_ioctl(dev->physical_device->local_fd,
+                    IOCTL_KGSL_GPUOBJ_INFO, &info_req);
+   if (ret) {
+      free_obj();
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to get host ptr info (%s)\n", strerror(errno));
+   }
+
+   /* The kernel decides how much to map. Make sure it is enough. */
+   if (info_req.size < size) {
+      free_obj();
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "KGSL mapped %llu of %llu requested bytes\n",
+                       (unsigned long long)info_req.size,
+                       (unsigned long long)size);
+   }
+
+   struct tu_bo *bo = tu_device_lookup_bo(dev, req.id);
+   assert(bo && bo->gem_handle == 0);
+
+   *bo = (struct tu_bo) {
+      .gem_handle = req.id,
+      .size = size,
+      .iova = info_req.gpuaddr,
+      .name = tu_debug_bos_add(dev, size, "host_ptr"),
+      .refcnt = 1,
+      .shared_fd = -1,
+   };
+   bo->map = host_ptr;
+   bo->is_host_ptr = true;
+   bo->never_unmap = true;
+   bo->unique_id = req.id;
+
+   tu_dump_bo_init(dev, bo);
+
+   *out_bo = bo;
+
+   return VK_SUCCESS;
+}
+
 static int
 kgsl_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo)
 {
@@ -497,7 +570,8 @@ kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
 
    if (bo->map) {
       TU_RMV(bo_unmap, dev, bo);
-      munmap(bo->map, bo->size);
+      if (!bo->is_host_ptr)
+         munmap(bo->map, bo->size);
    }
 
    if (bo->shared_fd != -1)
@@ -1870,6 +1944,7 @@ static const struct tu_knl kgsl_knl_funcs = {
       .submitqueue_close = kgsl_submitqueue_close,
       .bo_init = kgsl_bo_init,
       .bo_init_dmabuf = kgsl_bo_init_dmabuf,
+      .bo_init_host_ptr = kgsl_bo_init_host_ptr,
       .bo_export_dmabuf = kgsl_bo_export_dmabuf,
