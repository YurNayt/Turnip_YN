diff --git a/src/freedreno/ir3/ir3_context.c b/src/freedreno/ir3/ir3_context.c
index 1d6acf2..9e3044c 100644
--- a/src/freedreno/ir3/ir3_context.c
+++ b/src/freedreno/ir3/ir3_context.c
@@ -7,6 +7,7 @@
  */
 
 #include "ir3_context.h"
+#include "nir_builder.h"
 #include "ir3_compiler.h"
 #include "ir3_image.h"
 #include "ir3_nir.h"
@@ -21,6 +22,45 @@ should_lower_undef(nir_undef_instr *undef)
    return undef->def.bit_size == 1;
 }
 
+
+/* Some optimization can re-create fmadz after Mesa's late lowering of
+ * fmulz/fmadz (lower_fmulz_with_abs_min) has run, and ir3 has no
+ * instruction for it ("Unhandled ALU op: fmadz"). Lower leftovers with the
+ * same formula Mesa uses: min(|a|,|b|) == 0 ? c : fmad(a, b, c).
+ */
+static bool
+ir3_lower_leftover_fmadz_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_alu)
+      return false;
+
+   nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (alu->op != nir_op_fmadz)
+      return false;
+
+   b->cursor = nir_before_instr(instr);
+
+   unsigned nc = alu->def.num_components;
+   nir_def *x = nir_mov_alu(b, alu->src[0], nc);
+   nir_def *y = nir_mov_alu(b, alu->src[1], nc);
+   nir_def *z = nir_mov_alu(b, alu->src[2], nc);
+
+   nir_def *is_zero =
+      nir_feq_imm(b, nir_fmin(b, nir_fabs(b, x), nir_fabs(b, y)), 0.0);
+   nir_def *res = nir_bcsel(b, is_zero, z, nir_fmad(b, x, y, z));
+
+   nir_def_rewrite_uses(&alu->def, res);
+   nir_instr_remove(instr);
+   return true;
+}
+
+static bool
+ir3_lower_leftover_fmadz(nir_shader *shader)
+{
+   return nir_shader_instructions_pass(shader, ir3_lower_leftover_fmadz_instr,
+                                       nir_metadata_none, NULL);
+}
