+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetSemaphoreCounterValue(VkDevice device, VkSemaphore semaphore,
+                            uint64_t *pValue)
+{
+   VkResult r = vk_common_GetSemaphoreCounterValue(device, semaphore, pValue);
+   if (r == VK_SUCCESS && tu_hostptr_any()) {
+      /* Only when this semaphore's counter moved since we last looked. */
+      static struct { uint64_t sem, value; } seen[32];
+      static unsigned next;
+      static pthread_mutex_t seen_mtx = PTHREAD_MUTEX_INITIALIZER;
+      bool moved = true;
+      pthread_mutex_lock(&seen_mtx);
+      unsigned i;
+      for (i = 0; i < 32; i++)
+         if (seen[i].sem == (uint64_t)semaphore)
+            break;
+      if (i < 32) {
+         moved = seen[i].value != *pValue;
+         seen[i].value = *pValue;
+      } else {
+         seen[next].sem = (uint64_t)semaphore;
+         seen[next].value = *pValue;
+         next = (next + 1) % 32;
+      }
+      pthread_mutex_unlock(&seen_mtx);
+      if (moved)
+         tu_hostptr_sync_all();
+   }
+   return r;
+}
