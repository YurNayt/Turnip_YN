index 37a9dbe..523548c 100644
--- a/src/freedreno/vulkan/tu_knl.cc
+++ b/src/freedreno/vulkan/tu_knl.cc
@@ -1,3 +1,6 @@
+#include <time.h>
+#include <stdlib.h>
+#include <stdio.h>
 /*
  * Copyright © 2016 Red Hat.
  * Copyright © 2016 Bas Nieuwenhuizen
@@ -145,6 +148,151 @@ tu_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
    return dev->instance->knl->bo_map(dev, bo, placed_addr);
 }
 
+
+#include <pthread.h>
+
+/* Imported host memory is not IO-coherent on KGSL: maintain caches by hand. */
+#define TU_HOSTPTR_MAX 256
+static struct { void *ptr; uint64_t size; } tu_hostptr_list[TU_HOSTPTR_MAX];
+static unsigned tu_hostptr_count;
+static pthread_mutex_t tu_hostptr_mtx = PTHREAD_MUTEX_INITIALIZER;
+
+static void
+tu_hostptr_civac(void *p, uint64_t n)
+{
+#if defined(__aarch64__)
+   uint64_t ctr;
+   __asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+   uint64_t line = 4ull << ((ctr >> 16) & 0xf);
+   uintptr_t a = (uintptr_t)p & ~(uintptr_t)(line - 1);
+   uintptr_t end = (uintptr_t)p + n;
+   __asm__ volatile("dsb ish" ::: "memory");
+   for (; a < end; a += line)
+      __asm__ volatile("dc civac, %0" : : "r"(a) : "memory");
+   __asm__ volatile("dsb ish" ::: "memory");
+#else
+   (void)p; (void)n;
+#endif
+}
+
+bool
+tu_hostptr_any(void)
+{
+   return __atomic_load_n(&tu_hostptr_count, __ATOMIC_RELAXED) != 0;
+}
+
+void
+tu_hostptr_register(void *ptr, uint64_t size)
+{
+   pthread_mutex_lock(&tu_hostptr_mtx);
+   if (tu_hostptr_count < TU_HOSTPTR_MAX) {
+      tu_hostptr_list[tu_hostptr_count].ptr = ptr;
+      tu_hostptr_list[tu_hostptr_count].size = size;
+      __atomic_store_n(&tu_hostptr_count, tu_hostptr_count + 1, __ATOMIC_RELAXED);
+   }
+   pthread_mutex_unlock(&tu_hostptr_mtx);
+}
+
+void
+tu_hostptr_unregister(void *ptr)
+{
+   pthread_mutex_lock(&tu_hostptr_mtx);
+   for (unsigned i = 0; i < tu_hostptr_count; i++) {
+      if (tu_hostptr_list[i].ptr == ptr) {
+         tu_hostptr_list[i] = tu_hostptr_list[tu_hostptr_count - 1];
+         __atomic_store_n(&tu_hostptr_count, tu_hostptr_count - 1, __ATOMIC_RELAXED);
+         break;
+      }
+   }
+   pthread_mutex_unlock(&tu_hostptr_mtx);
+}
+
+static int
+tu_hostptr_mode(void)
+{
+   static int mode = -1;
+   if (mode < 0) {
+      const char *e = getenv("TU_HOSTPTR_SYNC");
+      mode = e ? atoi(e) : 2;
+      fprintf(stderr, "TUDBG hostptr sync mode %d\n", mode);
+   }
+   return mode;
+}
+
+static uint64_t
+tu_hostptr_now_ns(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+static void
+tu_hostptr_sync(int min_mode)
+{
+   if (!tu_hostptr_any() || tu_hostptr_mode() < min_mode)
+      return;
+   static uint64_t calls, total_ns, window_start;
+   uint64_t t0 = tu_hostptr_now_ns();
+   pthread_mutex_lock(&tu_hostptr_mtx);
+   uint64_t bytes = 0;
+   for (unsigned i = 0; i < tu_hostptr_count; i++) {
+      tu_hostptr_civac(tu_hostptr_list[i].ptr, tu_hostptr_list[i].size);
+      bytes += tu_hostptr_list[i].size;
+   }
+   uint64_t t1 = tu_hostptr_now_ns();
+   calls++;
+   total_ns += t1 - t0;
+   if (!window_start)
+      window_start = t1;
+   if (t1 - window_start >= 5000000000ull) {
+      fprintf(stderr, "TUDBG hostptr sync: %llu calls, %.1f ms in the last 5 s, %llu MB registered\n",
+              (unsigned long long)calls, total_ns / 1e6,
+              (unsigned long long)(bytes >> 20));
+      calls = total_ns = 0;
+      window_start = t1;
+   }
+   pthread_mutex_unlock(&tu_hostptr_mtx);
+}
+
+void
+tu_hostptr_sync_all(void)
+{
+   tu_hostptr_sync(1);   /* after waits */
+}
+
+void
+tu_hostptr_sync_submit(void)
+{
+   tu_hostptr_sync(2);   /* before submits */
+}
+
+VkResult
+tu_bo_init_host_ptr(struct tu_device *dev,
+                    struct tu_bo **bo,
+                    void *host_ptr,
+                    uint64_t size,
+                    enum tu_bo_alloc_flags flags)
+{
+   if (!dev->instance->knl->bo_init_host_ptr)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   size = align64(size, os_page_size);
+   VkResult result =
+      dev->instance->knl->bo_init_host_ptr(dev, bo, host_ptr, size, flags);
+   if (result != VK_SUCCESS)
+      return result;
+
+   tu_hostptr_register(host_ptr, size);
+
+   /* Memory comes from the app: needs flush/invalidate unless IO-coherent. */
+   if (!dev->physical_device->has_cached_coherent_memory &&
+       dev->physical_device->has_cached_non_coherent_memory)
+      (*bo)->cached_non_coherent = true;
+
+   return VK_SUCCESS;
+}
+
 VkResult
 tu_bo_unmap(struct tu_device *dev, struct tu_bo *bo, bool reserve)
 {
